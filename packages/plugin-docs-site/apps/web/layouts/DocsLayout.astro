---
import type { MarkdownHeading } from "astro";

import DocsSidebar from "../components/DocsSidebar.astro";
import {
  adjacentPages,
  buildSidebar,
  type DocsLocale,
  type DocsPage,
  docsPath,
} from "../lib/docs";
import { m } from "../src/paraglide/messages.js";
import { localizeHref } from "../src/paraglide/runtime.js";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  locale: DocsLocale;
  pages: DocsPage[];
  /** Undefined on the docs landing page. */
  page?: DocsPage;
  fallback?: boolean;
  headings?: MarkdownHeading[];
  title: string;
  description?: string;
}

const {
  locale,
  pages,
  page,
  fallback = false,
  headings = [],
  title,
  description,
} = Astro.props;

const sections = buildSidebar(pages, locale);
const currentSlug = page?.slug ?? "";
const { previous, next } = adjacentPages(sections, currentSlug);
const toc = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto flex w-full max-w-7xl gap-10 px-4 py-10 sm:px-6 lg:px-8">
    <aside class="hidden w-60 shrink-0 lg:block">
      <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto pr-2">
        <a
          href={localizeHref("/docs/")}
          class="mb-6 block px-2 text-base font-semibold text-foreground"
        >
          {m.docs_title()}
        </a>
        <DocsSidebar
          sections={sections}
          currentSlug={currentSlug}
          fallbackLabel={m.docs_fallback_badge()}
        />
      </div>
    </aside>

    <div class="min-w-0 flex-1">
      <details class="mb-6 rounded-lg border border-border lg:hidden">
        <summary class="cursor-pointer px-4 py-2 text-sm font-medium">
          {m.docs_title()}
        </summary>
        <div class="px-4 pb-4">
          <DocsSidebar
            sections={sections}
            currentSlug={currentSlug}
            fallbackLabel={m.docs_fallback_badge()}
          />
        </div>
      </details>

      {
        fallback && (
          <p
            role="note"
            class="mb-6 rounded-md border border-amber-300/60 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-500/40 dark:bg-amber-950/40 dark:text-amber-100"
          >
            {m.docs_fallback_notice()}
          </p>
        )
      }

      <article
        class="prose prose-neutral max-w-none dark:prose-invert prose-headings:scroll-mt-24 prose-pre:rounded-lg"
      >
        <h1>{title}</h1>
        {description && <p class="lead">{description}</p>}
        {
          page?.sourceVersion && (
            <p class="text-sm text-muted-foreground">
              {m.docs_source_version({ version: page.sourceVersion })}
            </p>
          )
        }
        <slot />
      </article>

      {
        (previous || next) && (
          <nav
            aria-label="Pagination"
            class="mt-12 flex items-stretch justify-between gap-4 border-t border-border pt-6 text-sm"
          >
            {previous ? (
              <a
                href={localizeHref(docsPath(previous.slug))}
                class="flex-1 rounded-lg border border-border px-4 py-3 hover:bg-accent/60"
              >
                <span class="block text-xs text-muted-foreground">
                  {m.docs_previous()}
                </span>
                <span class="font-medium">{previous.title}</span>
              </a>
            ) : (
              <span class="flex-1" />
            )}
            {next ? (
              <a
                href={localizeHref(docsPath(next.slug))}
                class="flex-1 rounded-lg border border-border px-4 py-3 text-right hover:bg-accent/60"
              >
                <span class="block text-xs text-muted-foreground">
                  {m.docs_next()}
                </span>
                <span class="font-medium">{next.title}</span>
              </a>
            ) : (
              <span class="flex-1" />
            )}
          </nav>
        )
      }
    </div>

    {
      toc.length > 0 && (
        <aside class="hidden w-56 shrink-0 xl:block">
          <div class="sticky top-24 text-sm">
            <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground">
              {m.docs_on_this_page()}
            </p>
            <ul class="space-y-1 border-l border-border">
              {toc.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class:list={[
                      "block border-l-2 border-transparent py-0.5 text-muted-foreground hover:border-foreground/40 hover:text-foreground",
                      heading.depth === 2 ? "pl-3" : "pl-6",
                    ]}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      )
    }
  </div>
</BaseLayout>
