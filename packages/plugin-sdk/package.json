{
  "name": "@ghostboard/sdk",
  "version": "0.1.0",
  "description": "GhostBoard trusted plugin SDK, author reference, tests and deterministic packer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laogui/electrobun-starter-tanstack.git",
    "directory": "packages/plugin-sdk"
  },
  "homepage": "https://ghostboard.app/docs/reference/sdk/",
  "keywords": [
    "ghostboard",
    "plugin",
    "sdk"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "bin": {
    "ghostboard-plugin": "./package-plugin.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "import": "./react.js"
    },
    "./testing": {
      "types": "./testing.d.ts",
      "import": "./testing.js"
    },
    "./testing/react": {
      "types": "./testing/react.d.ts",
      "import": "./testing/react.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "react.js",
    "react.d.ts",
    "testing.js",
    "testing.d.ts",
    "testing/react.js",
    "testing/react.d.ts",
    "AI_REFERENCE.md",
    "package-plugin.js",
    "package-plugin.d.ts",
    "README.md"
  ],
  "peerDependencies": {
    "@testing-library/react": "^16.0.0",
    "react": "19.2.x",
    "react-dom": "19.2.x"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    }
  },
  "dependencies": {
    "@types/react": "~19.2.0"
  }
}
