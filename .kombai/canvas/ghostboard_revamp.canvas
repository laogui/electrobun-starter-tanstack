      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Lora:wght@500;600;700&family=Public+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .font-heading { font-family: 'Lora', serif; }\n  .font-body { font-family: 'Public Sans', sans-serif; }\n\n  .gb-app {\n    background-color: #F4F0EC;\n    background-image: radial-gradient(circle, rgba(123,160,91,0.35) 1px, transparent 1.4px);\n    background-size: 22px 22px;\n  }\n\n  .gb-tilt-a { transform: rotate(-0.6deg); }\n  .gb-tilt-b { transform: rotate(0.5deg); }\n  .gb-tilt-c { transform: rotate(-0.4deg); }\n\n  .shadow-elev {\n    box-shadow: 0 2px 4px rgba(59,47,34,0.05), 0 10px 22px rgba(59,47,34,0.08);\n  }\n  .shadow-elev-lg {\n    box-shadow: 0 4px 10px rgba(59,47,34,0.08), 0 18px 34px rgba(59,47,34,0.12);\n  }\n  .shadow-sage {\n    box-shadow: 0 4px 10px rgba(123,160,91,0.20), 0 12px 22px rgba(123,160,91,0.18);\n  }\n  .shadow-copper {\n    box-shadow: 0 4px 10px rgba(208,83,64,0.22), 0 12px 22px rgba(208,83,64,0.18);\n  }\n  .shadow-mint {\n    box-shadow: 0 4px 10px rgba(97,150,120,0.22), 0 12px 22px rgba(97,150,120,0.16);\n  }\n  .shadow-butter {\n    box-shadow: 0 4px 10px rgba(196,160,54,0.24), 0 12px 22px rgba(196,160,54,0.16);\n  }\n  .shadow-black {\n    box-shadow: 0 4px 10px rgba(20,16,12,0.35), 0 16px 30px rgba(20,16,12,0.3);\n  }\n\n  .card-lift-hover {\n    transform: translateY(-3px) rotate(-0.4deg);\n    box-shadow: 0 8px 18px rgba(123,160,91,0.28), 0 22px 36px rgba(123,160,91,0.2);\n  }\n\n  .paper-stack::before, .paper-stack::after {\n    content: \"\";\n    position: absolute;\n    left: 6px; right: 6px;\n    background: #EFE9E1;\n    border: 1px solid rgba(59,47,34,0.08);\n    border-radius: 10px;\n    z-index: 0;\n  }\n  .paper-stack::before { bottom: -6px; left: 10px; right: 10px; }\n  .paper-stack::after { bottom: -3px; left: 8px; right: 8px; }\n\n  .folder-tab {\n    position: absolute;\n    top: -10px;\n    left: 14px;\n    width: 60px;\n    height: 16px;\n    background: #7BA05B;\n    border-radius: 6px 6px 0 0;\n    z-index: 3;\n  }\n\n  .polaroid-frame {\n    background: #FEFEFA;\n    border: 1px solid rgba(59,47,34,0.06);\n  }\n\n  .conn-line { stroke: #7BA05B; stroke-width: 2; fill: none; }\n  .conn-dot { fill: #7BA05B; }\n\n  .checkbox-done {\n    background: #7BA05B;\n    border-color: #7BA05B;\n  }\n</style>\n\n<div class=\"gb-app font-body relative w-full\" style=\"height:900px; min-width:1440px; color:#3B2F22;\" data-kid=\"1\">\n\n  \n  <div class=\"absolute top-5 left-5 flex items-center gap-2 z-30\" data-kid=\"2\">\n    <span class=\"w-3 h-3 rounded-full\" style=\"background:#EE6A5F;\" data-kid=\"3\"></span>\n    <span class=\"w-3 h-3 rounded-full\" style=\"background:#F5BD4F;\" data-kid=\"4\"></span>\n    <span class=\"w-3 h-3 rounded-full\" style=\"background:#61C454;\" data-kid=\"5\"></span>\n  </div>\n\n  \n  <div class=\"absolute top-4 left-1/2 -translate-x-1/2 z-30 flex items-center gap-2 bg-[#FEFEFA] rounded-full px-4 py-2.5 shadow-elev\" style=\"width:420px;\" data-kid=\"6\">\n    <i class=\"ti ti-search text-[#8A7A63] text-base\" data-kid=\"7\"></i>\n    <span class=\"text-sm text-[#9C8E78] flex-1\" data-kid=\"8\">Search notes, links, folders...</span>\n    <span class=\"text-[10px] font-semibold text-[#8A7A63] bg-[#F4F0EC] rounded-md px-1.5 py-0.5\" data-kid=\"9\">⌘K</span>\n  </div>\n\n  \n  <div class=\"absolute top-16 left-6 z-30 flex flex-col gap-2 bg-[#FEFEFA] rounded-2xl p-1.5 shadow-elev\" data-kid=\"10\">\n    <button class=\"w-8 h-8 rounded-xl flex items-center justify-center text-[#5A4E3C] hover:bg-[#F4F0EC]\" data-kid=\"11\">\n      <i class=\"ti ti-layout-grid text-base\" data-kid=\"12\"></i>\n    </button>\n    <button class=\"w-8 h-8 rounded-xl flex items-center justify-center text-[#5A4E3C] hover:bg-[#F4F0EC] relative\" data-kid=\"13\">\n      <i class=\"ti ti-tag text-base\" data-kid=\"14\"></i>\n      <span class=\"absolute top-0.5 right-0.5 w-1.5 h-1.5 rounded-full\" style=\"background:#D05340;\" data-kid=\"15\"></span>\n    </button>\n  </div>\n\n  \n  <div class=\"absolute top-5 right-6 z-30 w-9 h-9 rounded-full bg-[#FEFEFA] shadow-elev flex items-center justify-center text-[#5A4E3C]\" data-kid=\"16\">\n    <i class=\"ti ti-settings text-base\" data-kid=\"17\"></i>\n  </div>\n\n  \n  <div class=\"absolute inset-0 pt-24 px-6\" data-kid=\"18\">\n\n    \n    \n    <div class=\"absolute rounded-xl p-4 shadow-black gb-tilt-c\" style=\"left:60px; top:60px; width:200px; height:150px; background:#33281C; color:#F4EFE7;\" data-kid=\"19\">\n      <div class=\"font-heading text-[13px] font-semibold leading-snug\" data-kid=\"20\">Alpha feedback Target audience</div>\n      <div class=\"text-[11px] text-[#C9BBA4] mt-3\" data-kid=\"21\">Empty note</div>\n    </div>\n\n    \n    <div class=\"absolute rounded-xl p-4 shadow-elev bg-[#FEFEFA] gb-tilt-a\" style=\"left:280px; top:60px; width:210px; height:150px; overflow:hidden;\" data-kid=\"22\">\n      <div class=\"font-heading text-[13px] font-semibold text-[#3B2F22]\" data-kid=\"23\">dsfsdfds</div>\n      <div class=\"text-[9px] text-[#7A6C57] leading-tight mt-1\" data-kid=\"24\">Documentation index<span class=\"underline\" data-kid=\"25\">fetch the complete documentation index at:</span></div>\n      <div class=\"text-[9px] underline text-[#7A6C57]\" data-kid=\"26\">https://docs.devin.txt Use this file to discover all available pages before exploring further.</div>\n      <div class=\"font-heading text-[11px] font-semibold text-[#3B2F22] mt-2\" data-kid=\"27\">Devin Local Agent</div>\n      <div class=\"text-[8px] text-[#8A7A63] leading-tight\" data-kid=\"28\">Use the same agent harness as Devin CLI directly inside Devin Desktop.</div>\n    </div>\n\n    \n    <div class=\"absolute rounded-sm p-3.5 shadow-sage gb-tilt-b\" style=\"left:510px; top:56px; width:150px; height:158px; background:#E7EEDC;\" data-kid=\"29\">\n      <div class=\"font-heading text-[12px] font-semibold text-[#42522F]\" data-kid=\"30\">Prio before launch</div>\n      <div class=\"text-[10px] font-semibold text-[#5C6B47] mt-2\" data-kid=\"31\">Lingering bugs</div>\n      <div class=\"flex items-start gap-1.5 mt-2\" data-kid=\"32\">\n        <span class=\"w-3 h-3 rounded-sm border border-[#7BA05B] checkbox-done flex-shrink-0 mt-0.5\" data-kid=\"33\"></span>\n        <span class=\"text-[8.5px] text-[#4C5A3B] leading-tight\" data-kid=\"34\">Dragging around not felt obvious because of scroll</span>\n      </div>\n      <div class=\"flex items-start gap-1.5 mt-1.5\" data-kid=\"35\">\n        <span class=\"w-3 h-3 rounded-sm border border-[#7BA05B] flex-shrink-0 mt-0.5\" data-kid=\"36\"></span>\n        <span class=\"text-[8.5px] text-[#4C5A3B] leading-tight\" data-kid=\"37\">When pasting images/screenshots</span>\n      </div>\n      <div class=\"flex items-start gap-1.5 mt-1.5\" data-kid=\"38\">\n        <span class=\"w-3 h-3 rounded-sm border border-[#7BA05B] flex-shrink-0 mt-0.5\" data-kid=\"39\"></span>\n        <span class=\"text-[8.5px] text-[#4C5A3B] leading-tight\" data-kid=\"40\">Drop area on desktop border around</span>\n      </div>\n    </div>\n\n    \n    <div class=\"absolute rounded-sm p-3.5 shadow-copper gb-tilt-a\" style=\"left:672px; top:52px; width:150px; height:158px; background:#F3E1DC;\" data-kid=\"41\">\n      <div class=\"font-heading text-[12px] font-semibold text-[#7A362A]\" data-kid=\"42\">Bugs</div>\n      <div class=\"text-[10px] font-semibold text-[#8A4636] mt-2\" data-kid=\"43\">Alpha feedback</div>\n      <div class=\"flex items-start gap-1.5 mt-2\" data-kid=\"44\">\n        <span class=\"w-3 h-3 rounded-sm border border-[#D05340] checkbox-done flex-shrink-0 mt-0.5\" style=\"background:#D05340;border-color:#D05340;\" data-kid=\"45\"></span>\n        <span class=\"text-[8.5px] text-[#7A362A] leading-tight\" data-kid=\"46\">Reply-to-all emoji from Kali.rio, no get \"Nice feedback\"</span>\n      </div>\n      <div class=\"flex items-start gap-1.5 mt-1.5\" data-kid=\"47\">\n        <span class=\"w-3 h-3 rounded-sm border border-[#D05340] flex-shrink-0 mt-0.5\" data-kid=\"48\"></span>\n        <span class=\"text-[8.5px] text-[#7A362A] leading-tight\" data-kid=\"49\">Click picture to dismiss content</span>\n      </div>\n      <div class=\"flex items-start gap-1.5 mt-1.5\" data-kid=\"50\">\n        <span class=\"w-3 h-3 rounded-sm border border-[#D05340] flex-shrink-0 mt-0.5\" data-kid=\"51\"></span>\n        <span class=\"text-[8.5px] text-[#7A362A] leading-tight\" data-kid=\"52\">Nicely handles overlaps type, and dismisses control</span>\n      </div>\n    </div>\n\n    \n    <div class=\"absolute rounded-xl p-3 shadow-elev bg-[#FEFEFA]\" style=\"left:1200px; top:24px; width:150px; height:100px;\" data-kid=\"53\">\n      <div class=\"text-[8px] font-semibold text-[#9C8E78] absolute top-2 right-3\" data-kid=\"54\">AUDIO</div>\n      <div class=\"flex items-center gap-2 mt-4\" data-kid=\"55\">\n        <div class=\"w-7 h-7 rounded-lg flex items-center justify-center flex-shrink-0\" style=\"background:#E7EEDC;\" data-kid=\"56\">\n          <i class=\"ti ti-microphone text-[#7BA05B] text-xs\" data-kid=\"57\"></i>\n        </div>\n        <div class=\"flex items-end gap-[1.5px] h-5 flex-1\" data-kid=\"58\">\n          <span class=\"w-[2px] bg-[#C9C2B4] rounded-full\" style=\"height:30%\" data-kid=\"59\"></span>\n          <span class=\"w-[2px] bg-[#C9C2B4] rounded-full\" style=\"height:60%\" data-kid=\"60\"></span>\n          <span class=\"w-[2px] bg-[#C9C2B4] rounded-full\" style=\"height:90%\" data-kid=\"61\"></span>\n          <span class=\"w-[2px] bg-[#C9C2B4] rounded-full\" style=\"height:45%\" data-kid=\"62\"></span>\n          <span class=\"w-[2px] bg-[#C9C2B4] rounded-full\" style=\"height:70%\" data-kid=\"63\"></span>\n          <span class=\"w-[2px] bg-[#C9C2B4] rounded-full\" style=\"height:35%\" data-kid=\"64\"></span>\n    