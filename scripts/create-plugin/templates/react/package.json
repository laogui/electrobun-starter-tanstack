{
  "name": "ghostboard-react-hello",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:shim": "vite build --config vite.shim.config.ts",
    "dev": "vite build --watch",
    "package": "bun run build && bun sdk/package-plugin.js dist --output release/example.react-hello-0.1.0.ghostboard-plugin",
    "test": "bun test",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ghostboard/sdk": "file:./sdk",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.8"
  }
}
