{
  "name": "ghostboard",
  "version": "1.0.0",
  "description": "GhostBoard — a local-first spatial canvas for visual knowledge management",
  "license": "MIT",
  "scripts": {
    "start": "vite build && electrobun dev",
    "dev": "electrobun dev --watch",
    "dev:hmr": "vite build && concurrently \"bun run hmr\" \"electrobun dev\"",
    "hmr": "vite --port 5173",
    "build:canary": "vite build && electrobun build --env=canary",
    "build:stable": "vite build && electrobun build --env=stable",
    "test:plugin-t0": "bun scripts/trusted-plugin-t0/run.ts",
    "test:plugin-t1": "bun scripts/trusted-plugin-t1/run.ts",
    "test:plugin-t2-a4": "bun scripts/trusted-plugin-t2-a4/run.ts",
    "test:plugin-t2-content": "bun scripts/trusted-plugin-t2-content/run.ts",
    "test:plugin-t2-selection": "bun scripts/trusted-plugin-t2-selection/run.ts",
    "test:plugin-t2-canvas": "bun scripts/trusted-plugin-t2-canvas/run.ts",
    "test:plugin-t2-history": "bun scripts/trusted-plugin-t2-history/run.ts",
    "test:plugin-t3-fixture": "bun scripts/trusted-plugin-t3/verify-fixture.ts",
    "test:plugin-t3-exit-fixtures": "bun scripts/trusted-plugin-t3/verify-exit-fixtures.ts",
    "test:plugin-t3": "bun scripts/trusted-plugin-t3/run.ts",
    "test:plugin-t4": "bun scripts/trusted-plugin-t4/run.ts",
    "test:plugin-t5-compat": "bun scripts/trusted-plugin-t5/verify-compat-docs.ts",
    "test:plugin-t5": "bun scripts/trusted-plugin-t5/run.ts",
    "plugin:examples": "bun scripts/upload-plugin-examples.ts",
    "test:plugin-templates": "bun packages/create-plugin/verify-templates.ts",
    "plugin:create": "bun scripts/create-plugin.ts",
    "plugin:pack": "bun packages/plugin-sdk/package-plugin.js",
    "upload:r2": "bun scripts/upload-r2.ts",
    "release:canary": "bun run build:canary && bun scripts/upload-r2.ts --env=canary",
    "release:stable": "bun run build:stable && bun scripts/upload-r2.ts --env=stable",
    "type-check": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations --silent && bun scripts/type-check.ts",
    "lint": "ultracite check --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci": "concurrently \"bun run type-check\" \"bun run check\" \"bun run format:check\"",
    "machine-translate": "inlang machine translate --project project.inlang",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install && bun scripts/ensure-electrobun-cli.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.135",
    "@ai-sdk/openai": "^3.0.131",
    "@ai-sdk/openai-compatible": "^2.0.87",
    "@base-ui/react": "^1.4.0",
    "@blocknote/core": "^0.51.4",
    "@blocknote/mantine": "^0.51.4",
    "@blocknote/react": "^0.51.4",
    "@blocknote/xl-ai": "^0.51.4",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-router": "^1.170.45",
    "@xyflow/react": "^12.10.2",
    "ai": "^6.0.312",
    "better-themes": "^1.1.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.0",
    "electrobun": "^1.18.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.8.0",
    "markdown-it": "^14.1.1",
    "markdown-it-task-lists": "^2.1.1",
    "motion": "^12.38.0",
    "nanoid": "^5.1.9",
    "overlayscrollbars": "^2.15.1",
    "overlayscrollbars-react": "^0.5.6",
    "react": "19.2.5",
    "react-colorful": "^5.8.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.5",
    "react-textarea-autosize": "^8.5.9",
    "sanitize-html": "^2.17.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.1",
    "@inlang/cli": "^3.1.9",
    "@inlang/paraglide-js": "^2.16.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/devtools-vite": "^0.5.5",
    "@tanstack/react-devtools": "^0.9.13",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/react-query-devtools": "^5.99.0",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.47",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "1.3.12",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@typescript/native-preview": "7.0.0-dev.20260306.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.5",
    "jsdom": "^26.1.0",
    "lefthook": "^2.1.5",
    "tailwindcss": "^4.2.1",
    "typescript": "^6.0.3",
    "ultracite": "7.6.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@tiptap/core": "3.30.5",
    "@tiptap/extension-bold": "3.30.5",
    "@tiptap/extension-bubble-menu": "3.30.5",
    "@tiptap/extension-code": "3.30.5",
    "@tiptap/extension-floating-menu": "3.30.5",
    "@tiptap/extension-horizontal-rule": "3.30.5",
    "@tiptap/extension-italic": "3.30.5",
    "@tiptap/extension-paragraph": "3.30.5",
    "@tiptap/extension-strike": "3.30.5",
    "@tiptap/extension-text": "3.30.5",
    "@tiptap/extension-underline": "3.30.5",
    "@tiptap/extensions": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/react": "3.30.5",
    "basic-ftp": "^6.2.1",
    "prosemirror-model": "1.25.12",
    "solid-js": "^1.9.17"
  }
}
