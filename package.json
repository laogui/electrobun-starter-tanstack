{
  "name": "ghostboard",
  "version": "1.0.0",
  "description": "GhostBoard — a local-first spatial canvas for visual knowledge management",
  "scripts": {
    "start": "vite build && electrobun dev",
    "dev": "electrobun dev --watch",
    "dev:hmr": "vite build && concurrently \"bun run hmr\" \"electrobun dev\"",
    "hmr": "vite --port 5173",
    "build:canary": "vite build && electrobun build --env=canary",
    "type-check": "tsgo --noEmit",
    "lint": "ultracite check --fix",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci": "concurrently \"bun run type-check\" \"bun run lint\" \"bun run format\"",
    "machine-translate": "inlang machine translate --project project.inlang",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/devtools-vite": "^0.5.5",
    "@tanstack/react-devtools": "^0.9.13",
    "@tanstack/react-form": "^1.29.0",
    "@tanstack/react-form-devtools": "^0.2.21",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-router": "^1.168.22",
    "@tanstack/router-plugin": "^1.167.22",
    "@tiptap/core": "^3.22.4",
    "@tiptap/extension-image": "^3.22.4",
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/extension-placeholder": "^3.22.4",
    "@tiptap/extension-task-item": "^3.22.4",
    "@tiptap/extension-task-list": "^3.22.4",
    "@tiptap/markdown": "^3.22.4",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/react": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "@typescript/native-preview": "7.0.0-dev.20260306.1",
    "@xyflow/react": "^12.10.2",
    "better-themes": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.0",
    "electrobun": "1.16.0",
    "lucide-react": "^1.8.0",
    "markdown-it": "^14.1.1",
    "markdown-it-task-lists": "^2.1.1",
    "motion": "^12.38.0",
    "nanoid": "^5.1.9",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "sanitize-html": "^2.17.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "type-fest": "^5.4.4",
    "vite-tsconfig-paths": "^6.1.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.1",
    "@inlang/cli": "^3.1.9",
    "@inlang/paraglide-js": "^2.16.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query-devtools": "^5.99.0",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "latest",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.0.18",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.1.0",
    "jsdom": "^26.1.0",
    "lefthook": "^2.1.5",
    "lint-staged": "^16.4.0",
    "shadcn": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "ultracite": "7.6.0",
    "vite": "^8.0.8",
    "vitest": "^4.0.18",
    "web-vitals": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bunx ultracite fix"
    ]
  }
}
