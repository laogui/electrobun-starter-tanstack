{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/jest",
    "ultracite/biome/vitest"
  ],
  "files": {
    "includes": [
      "**",
      "!src/paraglide",
      "!src/mainview/routeTree.gen.ts",
      // Drop-in for the react-starter-kit Astro site; formatted by that repo's Prettier.
      "!packages/plugin-docs-site",
      "!!.delta",
      "!!.delta"
    ]
  },
  "javascript": {
    "globals": ["Bun", "__GHOSTBOARD_PLUGIN_PROBES__"],
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "style": {
        "useFilenamingConvention": "off",
        "noNonNullAssertion": "off",
        "noNestedTernary": "off",
        "noExportedImports": "off",
        "useDefaultSwitchClause": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noArrayIndexKey": "off",
        "noNonNullAssertedOptionalChain": "off",
        "noEmptyBlockStatements": "off",
        "useAwait": "off",
        "noAssignInExpressions": "off"
      },
      "performance": {
        "noNamespaceImport": "off",
        "noBarrelFile": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off"
      },
      "correctness": {
        "useImageSize": "off"
      },
      "a11y": {
        "noStaticElementInteractions": "off",
        "noNoninteractiveElementInteractions": "off",
        "useKeyWithClickEvents": "off"
      }
    }
  }
}
