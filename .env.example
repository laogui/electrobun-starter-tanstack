# Copy to .env and fill in real values. .env is gitignored — never commit secrets.
# In CI, provide these as GitHub Actions secrets instead of committing them.

# ─── Cloudflare R2 (release hosting) ────────────────────────────────────────
# Cloudflare account id (found in the R2 dashboard / endpoint URL).
R2_ACCOUNT_ID=
# R2 API token credentials (S3-compatible). Create under R2 > Manage API Tokens.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Target bucket name, e.g. ghostboard-releases
R2_BUCKET=
# Optional key prefix inside the bucket (leave empty to upload to the root).
# If set (e.g. "releases/"), it MUST match the path in R2_PUBLIC_BASE_URL.
R2_KEY_PREFIX=
# Public base URL served by your R2 custom domain. MUST end with a slash.
# Used as electrobun release.baseUrl; the updater fetches update.json from here.
R2_PUBLIC_BASE_URL=https://dl.example.com/

# ─── Apple code signing & notarization (macOS only) ─────────────────────────
# When these are present, non-dev builds are signed + notarized automatically.
# Leave them empty for unsigned local builds.
# Full identity string, e.g. "Developer ID Application: Your Name (TEAMID)".
ELECTROBUN_DEVELOPER_ID=
# Apple Developer Team ID, e.g. ABCDE12345.
ELECTROBUN_TEAMID=
# Apple ID email used for notarization.
ELECTROBUN_APPLEID=
# App-specific password generated at appleid.apple.com (not your Apple password).
ELECTROBUN_APPLEIDPASS=

# Windows builds are intentionally left unsigned for now.

# Feedback and crash reports. Set this when building canary/stable releases.
# This public URL is embedded in the desktop bundle; never put credentials here.
# Dev defaults to http://localhost:8787/api/v1.
GHOSTBOARD_SUPPORT_API_URL=https://api.example.com/api/v1
