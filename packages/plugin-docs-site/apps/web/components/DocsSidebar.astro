---
import { docsPath, type SidebarSection } from "../lib/docs";
import { localizeHref } from "../src/paraglide/runtime.js";

interface Props {
  sections: SidebarSection[];
  currentSlug: string;
  fallbackLabel: string;
}

const { sections, currentSlug, fallbackLabel } = Astro.props;
---

<nav aria-label="Documentation" class="text-sm">
  {
    sections.map((section) => (
      <div class="mb-6">
        <p class="mb-2 px-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground">
          {section.title}
        </p>
        <ul class="space-y-0.5">
          {section.items.map((item) => {
            const active = item.slug === currentSlug;
            return (
              <li>
                <a
                  href={localizeHref(docsPath(item.slug))}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "block rounded-md px-2 py-1.5 transition-colors",
                    active
                      ? "bg-accent font-medium text-foreground"
                      : "text-muted-foreground hover:bg-accent/60 hover:text-foreground",
                  ]}
                >
                  {item.title}
                  {item.fallback && (
                    <span
                      class="ml-1 text-[10px] uppercase text-muted-foreground/70"
                      title={fallbackLabel}
                    >
                      EN
                    </span>
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</nav>
